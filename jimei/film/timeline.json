 "captions": [
  {
   "id": "T01",
   "start": 0.6,
   "end": 5.8,
   "text": "这首歌，适合在很累的夜里听。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "很累",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T02",
   "start": 7.6,
   "end": 12.2,
   "text": "孙燕姿《极美》",
   "size_px": 30
  },
  {
   "id": "T03",
   "start": 15.2,
   "end": 20.2,
   "text": "热闹是一件盔甲。",
   "size_px": 46
  },
  {
   "id": "T04",
   "start": 20.8,
   "end": 25.4,
   "text": "散场之后，才轮到真正的自己。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "真正的自己",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T05",
   "start": 27.6,
   "end": 33.2,
   "text": "累的时候，人会觉得心里空了一块。",
   "size_px": 46
  },
  {
   "id": "T06",
   "start": 40.2,
   "end": 45.0,
   "text": "她写的光，都很小——",
   "size_px": 46,
   "emphasis": [
    {
     "word": "光",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T07",
   "start": 45.4,
   "end": 50.6,
   "text": "一盏灯、一片月光、一把伞、一件旧外套。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "灯",
     "color": "#E8892B"
    },
    {
     "word": "月光",
     "color": "#A9B9D0"
    },
    {
     "word": "伞",
     "color": "#C0543F"
    },
    {
     "word": "旧外套",
     "color": "#C9A46A"
    }
   ]
  },
  {
   "id": "T08",
   "start": 64.5,
   "end": 69.4,
   "text": "小，但够用。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "够用",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T09",
   "start": 72.2,
   "end": 77.0,
   "text": "这是《跳舞的梵谷》的最后一首歌。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "《跳舞的梵谷》",
     "color": "#F2C14E"
    }
   ]
  },
  {
   "id": "T10",
   "start": 77.4,
   "end": 82.3,
   "text": "歌里的麦田，呼应梵高 1890 年的《麦田群鸦》。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "《麦田群鸦》",
     "color": "#F2C14E"
    }
   ]
  },
  {
   "id": "T11",
   "start": 84.2,
   "end": 88.6,
   "text": "画里的乌鸦，常被读作死亡，也被读作重生。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "重生",
     "color": "#F2C14E"
    }
   ]
  },
  {
   "id": "T12",
   "start": 89.0,
   "end": 94.6,
   "text": "她把麦田，写成了人们重新聚拢的地方。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "重新聚拢",
     "color": "#F2C14E"
    }
   ]
  },
  {
   "id": "T13",
   "start": 99.0,
   "end": 104.0,
   "text": "落叶回到土里，不是结束，",
   "size_px": 46
  },
  {
   "id": "T14",
   "start": 104.4,
   "end": 109.8,
   "text": "是下一季开始的地方。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "下一季",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T15",
   "start": 113.0,
   "end": 118.0,
   "text": "被照亮过的人，",
   "size_px": 46
  },
  {
   "id": "T16",
   "start": 118.4,
   "end": 123.2,
   "text": "后来也成了别人的光。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "光",
     "color": "#F0A04B"
    }
   ]
  },
  {
   "id": "T17",
   "start": 126.0,
   "end": 131.0,
   "text": "一个人熬不过的夜，",
   "size_px": 46
  },
  {
   "id": "T18",
   "start": 131.4,
   "end": 135.8,
   "text": "两个人就熬得过。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "两个人",
     "color": "#F0A04B"
    }
   ]
  },
  {
   "id": "T19",
   "start": 145.0,
   "end": 151.0,
   "text": "走散的人，总会在麦田里再见。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "再见",
     "color": "#F0A04B"
    }
   ]
  },
  {
   "id": "T20",
   "start": 156.0,
   "end": 160.8,
   "text": "桥段里，她不再争灰还是白，",
   "size_px": 46
  },
  {
   "id": "T21",
   "start": 161.4,
   "end": 166.6,
   "text": "只留下一个动作：抬头。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "抬头",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T22",
   "start": 174.2,
   "end": 179.4,
   "text": "所谓极美，",
   "size_px": 46,
   "emphasis": [
    {
     "word": "极美",
     "style": "bold"
    }
   ]
  },
  {
   "id": "T23",
   "start": 181.0,
   "end": 186.6,
   "text": "不是从不跌倒，",
   "size_px": 46
  },
  {
   "id": "T24",
   "start": 187.0,
   "end": 192.6,
   "text": "而是跌倒以后，我们还在一起。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "还在一起",
     "style": "bold"
    }
   ]
  },
  {
   "id": "T25",
   "start": 202.0,
   "end": 207.2,
   "text": "愿你累的时候，身边也有一盏灯。",
   "size_px": 46,
   "emphasis": [
    {
     "word": "一盏灯",
     "color": "#E8892B"
    }
   ]
  },
  {
   "id": "T26",
   "start": 207.6,
   "end": 211.2,
   "text": "音乐：孙燕姿《极美》　词：孙燕姿　曲：李庭光",
   "size_px": 30
  }
 ],
